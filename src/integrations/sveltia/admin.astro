---
import {
    title,
    config,
    githubOAuth,
} from "virtual:sourcepoet-sveltia/config";
---

<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8"/>

    <meta
            name="viewport"
            content="width=device-width, initial-scale=1"
    />

    <meta
            name="robots"
            content="noindex"
    />

    <title>{title}</title>
</head>

<body>
<script>
    import { init } from "@sveltia/cms";

        import {
            config,
            githubOAuth,
            } from "virtual:sourcepoet-sveltia/config";

        const runtimeConfig = structuredClone(config);

        if (githubOAuth.enabled && runtimeConfig.backend?.name === "github") {
            runtimeConfig.backend.base_url = window.location.origin;
            runtimeConfig.backend.auth_endpoint = githubOAuth.authEndpoint;
            }

        init({
            config: runtimeConfig,
            });
</script>
</body>
</html>