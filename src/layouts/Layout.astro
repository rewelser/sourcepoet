//
// import "@fontsource/fleur-de-leah/400.css";
---

<BaseLayout title={title} description={description} ogImage={ogImage} preloadImage={preloadImage}
            bodyClass={`min-h-screen text-neutral-800 font-[Spectral] bg-black relative ${!isHome ? "promo-bar-offset promo-bar-transitions" : ""}`}
            {...rest}>
    <Fragment slot="head">
        <!-- <ClientRouter /> {/* enable SPA-style navigation */} -->

        <!--<link-->
        <!--        rel="preload"-->
        <!--        href={fleurdeleahUrl}-->
        <!--        as="font"-->
        <!--        type="font/woff2"-->
        <!--        crossorigin-->
        <!--/>-->
        <slot name="head"/>
    </Fragment>
    <!--<Header-->
    <!--        variant={isHome ? "home" : "default"}-->
    <!--        defaults={defaults}-->
    <!--        site={site}-->
    <!--/>-->
    <Header />
    <main class="mx-auto">
        <div id="pagecontent-wrap" data-color-theme={pageTheme}>
            <slot/>
            {/* page content goes here */}
        </div>
    </main>
    <!--<Footer defaults={defaults} site={site}/>-->
