---

<Layout>

    <section id="hero" class=`py-20 px-(--pad) bg-cover bg-center` style={{ backgroundImage: `url(${paperbg.src})` }}>
        <div class="max-w-5xl mx-auto">
            <h1 class="text-2xl md:text-8xl font-bold tracking-tight">
                <FadeInImage src={logo} alt="Description of the photo"></FadeInImage>
            </h1>
        </div>
    </section>

    <section class="relative h-[5000px]">
        <div class="sticky top-0 h-screen overflow-x-hidden">
            <PerlishPointClouds
                    foregroundColor="#1e90ff"
                    backgroundColor="#000000"
                    maxProbabilityPeak={0.8}
                    minProbabilityPeak={0.4}
                    maxProbabilityTrough={0.02}
                    fieldSpeed={0.10}
                    fieldSpeed={0.05}
                    noiseScale={2.5}
                    width="100%"
                    height="100vh"
            />
        </div>
        <div class="py-20 absolute">
            <div style="height: 100vh; border-bottom: 1px solid #ccc;">
                <h2 style="text-align: center; padding-top: 40vh;">Filler Section</h2>
            </div>
            <div style="height: 100vh; border-bottom: 1px solid #ccc;">
                <h2 style="text-align: center; padding-top: 40vh;">Filler Section</h2>
            </div>
            <div style="height: 100vh; border-bottom: 1px solid #ccc;">
                <h2 style="text-align: center; padding-top: 40vh;">Filler Section</h2>
            </div>
        </div>

    </section>

    <style>
        body {
            //background-image: repeating-linear-gradient(45deg, #0000, #0000 10px, lab(88.9551% -.959665 -4.3943) 10px 11px);
            background-color: transparent;
            background-image: linear-gradient(
                    45deg,
                    transparent 47%,
                    #D8BFD8 47%,
                    #D8BFD8 50%,
                    transparent 50%,
                    transparent 97%,
                    #D8BFD8 97%,
                    #D8BFD8 50%
            );
            background-size: 1.5rem 1.5rem;
        }
    </style>
</Layout>