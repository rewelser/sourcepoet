    <script>
        const observer = new IntersectionObserver(async (entries) => {
            for (const entry of entries) {
                if (entry.isIntersecting) {
                    queueSequenceGroupAnimations(entry.target);
                }
            }
        }, {
            rootMargin: '0px 0px -200px 0px',
        });

        async function animateSequence(target: Element) {
            const lastChild = target.lastElementChild;

            const animationFinished = new Promise(resolve => {
                lastChild?.addEventListener('animationend', resolve, {once: true});
            });

            target.classList.add("animate");
            await animationFinished;
            await new Promise(resolve => setTimeout(resolve, 500));
            observer.unobserve(target);
        }

        function queueSequenceGroupAnimations(target: Element) {
            const sequenceTargets = target.querySelectorAll(".char-sequence");

            let sequence = Promise.resolve();

            for (const sequenceTarget of sequenceTargets) {
                sequence = sequence.then(() => animateSequence(sequenceTarget))
            }
        }

        document.querySelectorAll(".char-sequence").forEach((el) => observer.observe(el));
        document.querySelectorAll(".sequence-group").forEach((el) => observer.observe(el));
    </script>

