---

import PerlishPointClouds from "../PerlishPointClouds.astro";
import FadeInImage from "../FadeInImage.astro";
import paperbg from "/src/config/assets/paperbg.webp";
import {getSiteConfig} from "../../config/site.ts";
const site = await getSiteConfig();
const logoSmall = site.branding.logoSmall;


---
<header class="header px-(--pad) py-2 sticky top-0 z-50 h-16">
    <nav class="max-w-5xl mx-auto flex items-center justify-between h-full">
        <a href="/" class="font-semibold h-full flex items-center">
            <img
                    src={logoSmall.src}
                    class="h-full"
            />
        </a>

        <div class="flex gap-6 text-sm">
            <a href="/projects/">Projects</a>
            <a href="/about/">About</a>
        </div>
    </nav>
    <style>
        .header {
            border-bottom: 2px solid whitesmoke;
        }
    </style>
</header>