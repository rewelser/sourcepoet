---
import {Image} from "astro:assets";
import type {ComponentProps} from "astro/types";

// type Props = Omit<ComponentProps<typeof Image>, "onload">;
type Props = ComponentProps<typeof Image>;

const {
    class: className,
    ...imageProps
} = Astro.props;

const classes = [
    className,
].filter(Boolean).join(" ");

const animation = "var(--fade-up-in-animation)";
// const animTest = "fade-in 500ms ease";
---
<div>
    <Image
        {...imageProps}
        class={classes}
        onload="this.classList.add('image-in')"
    />
</div>

<style define:vars={{ animation }}>
    :global(.image-in) {
        animation: var(--animation);
    }
</style>