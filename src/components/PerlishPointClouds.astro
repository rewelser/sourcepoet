---
const {
    colors = {
        foregroundLightScheme: "#fffff0",
        backgroundLightScheme: "#808080",
        foregroundDarkScheme: "#fffff0",
        backgroundDarkScheme: "#808080",
    },
    maxProbabilityPeak = 0.8,
    minProbabilityPeak = 0.4,
    maxProbabilityTrough = 0.02,
    fieldSpeed = 0.15,
    noiseScale = 2.5,
    className,
    width = "100%",
    height = "100%",
} = Astro.props as {
    colors?: {
        foregroundLightScheme?: string;
        backgroundLightScheme?: string;
        foregroundDarkScheme?: string;
        backgroundDarkScheme?: string;
    };
    /** max probability at noise peaks, 0..1 (brightest parts) */
    maxProbabilityPeak?: number;
    /** min probability at noise peaks, 0..1 (shoulder of blobs) */
    minProbabilityPeak?: number;
    /** max probability at noise troughs, 0..1 (darkest parts) */
    maxProbabilityTrough?: number;
    /** how fast the noise field morphs */
    fieldSpeed?: number;
    /** scale of the noise field (smaller = bigger blobs) */
    noiseScale?: number;
    className?: string;
    width?: number | string;
    height?: number | string;
};

const cssWidth = typeof width === "number" ? `${width}px` : width;
const cssHeight = typeof height === "number" ? `${height}px` : height;
---

<div
        data-perlish-point-clouds
        data-config={JSON.stringify({
            colors,
            maxProbabilityPeak,
            minProbabilityPeak,
            maxProbabilityTrough,
            fieldSpeed,
            noiseScale,
            fixedWidth: width,
            fixedHeight: height,
        })}
        class={className}
        style={`width:${cssWidth};height:${cssHeight};display:block;position:relative;`}
></div>

<script>
    import * as THREE from "three";
    import vertexShader from "../domain/threejs/shaders/perlish.vert.glsl?raw";
    import fragmentShader from "../domain/threejs/shaders/perlish.frag.glsl?raw";

    const selector = "[data-perlish-point-clouds]";

    function initPerlishPointClouds(container: HTMLElement) {
        // Prevent duplicate initialization, including with Astro page transitions.
        if (container.dataset.perlishInitialized === "true") {
            return;
        }

        container.dataset.perlishInitialized = "true";

        const {
            colors,
            maxProbabilityPeak,
            minProbabilityPeak,
            maxProbabilityTrough,
            fieldSpeed,
            noiseScale,
        } = JSON.parse(container.dataset.config!);

        let foreground, background;
        const probe = document.querySelector(".color-scheme-probe");
        const color = getComputedStyle(probe).color;
        let colorScheme = color === "rgb(0, 0, 0)"
            ? "dark"
            : "light";

        if (colorScheme === "dark") {
            foreground = colors.foregroundDarkScheme;
            background = colors.backgroundDarkScheme;
        } else {
            foreground = colors.foregroundLightScheme;
            background = colors.backgroundLightScheme;
        }

        const makeColorVec3 = (hex: string) => {
            const color = new THREE.Color(hex);

            return new THREE.Vector3(
                color.r,
                color.g,
                color.b,
            );
        };

        // Renderer
        const renderer = new THREE.WebGLRenderer({
            antialias: false,
        });

        renderer.outputColorSpace = THREE.SRGBColorSpace;

        container.appendChild(renderer.domElement);

        // Scene + camera + fullscreen quad
        const scene = new THREE.Scene();

        const camera = new THREE.OrthographicCamera(
            -1,
            1,
            1,
            -1,
            0,
            1,
        );

        const geometry = new THREE.PlaneGeometry(2, 2);

        const material = new THREE.ShaderMaterial({
            uniforms: {
                time: {
                    value: 0.0,
                },
                resolution: {
                    value: new THREE.Vector2(1, 1),
                },
                foreground: {
                    value: makeColorVec3(foreground),
                },
                background: {
                    value: makeColorVec3(background),
                },
                maxProbPeak: {
                    value: maxProbabilityPeak,
                },
                minProbPeak: {
                    value: minProbabilityPeak,
                },
                maxProbTrough: {
                    value: maxProbabilityTrough,
                },
                fieldSpeed: {
                    value: fieldSpeed,
                },
                noiseScale: {
                    value: noiseScale,
                },
            },

            vertexShader: vertexShader,
            fragmentShader: fragmentShader,
        });

        material.toneMapped = false;

        const mesh = new THREE.Mesh(geometry, material);

        scene.add(mesh);

        const resize = () => {
            const width = container.clientWidth || window.innerWidth;
            const height = container.clientHeight || window.innerHeight;

            renderer.setPixelRatio(window.devicePixelRatio || 1);

            // Increase this to 2 or 3 if we want
            // a higher-resolution internal render.
            const scale = 1;

            renderer.setSize(
                width * scale,
                height * scale,
                false,
            );

            // Keep the canvas at the normal CSS size.
            renderer.domElement.style.width = `${width}px`;
            renderer.domElement.style.height = `${height}px`;
            renderer.domElement.style.imageRendering = "pixelated";

            // Use the actual drawing-buffer dimensions,
            // including devicePixelRatio.
            material.uniforms.resolution.value.set(
                renderer.domElement.width,
                renderer.domElement.height,
            );
        };

        resize();

        window.addEventListener("resize", resize);

        const start = performance.now();

        const animate = (now: number) => {
            const elapsed = (now - start) / 1000;
            material.uniforms.time.value = elapsed;
            renderer.render(scene, camera);
        };

        renderer.setAnimationLoop(animate);

        const cleanup = () => {
            window.removeEventListener("resize", resize);

            renderer.setAnimationLoop(null);

            geometry.dispose();
            material.dispose();
            renderer.dispose();

            mesh.removeFromParent();

            if (renderer.domElement.parentNode === container) {
                container.removeChild(renderer.domElement);
            }
            delete container.dataset.perlishInitialized;
        };

        // Important if you're using Astro's client router /
        // View Transitions.
        document.addEventListener("astro:before-swap", cleanup, {once: true});
    }

    function initAllPerlishPointClouds() {
        document.querySelectorAll<HTMLElement>(selector).forEach(initPerlishPointClouds);
    }

    // Standard page load.
    initAllPerlishPointClouds();

    // Supports pages loaded through Astro's client router.
    document.addEventListener("astro:page-load", initAllPerlishPointClouds);
</script>