---

---
<div class="carpenter-square">
    <div class="square-leg vertical"></div>
    <div class="square-leg horizontal"></div>

    <style>
        .carpenter-square {
            height: 100%;
            width: 100%;
            position: absolute;
            --color-edge-square: color-mix(in srgb, var(--color-edge), #000 20%);
            overflow: hidden;
            pointer-events: none;
        }

        @keyframes slide-in-down {
            from {
                transform: translateX(-100%) translateY(-100%);
            }

            to {
                transform: translateX(0) translateY(0);
            }
        }

        @keyframes easeOutBounceY {
            0% {
                transform: translateY(-100%);
            }
            4% {
                transform: translateY(-98.79%);
            }
            8% {
                transform: translateY(-95.16%);
            }
            12% {
                transform: translateY(-89.11%);
            }
            16% {
                transform: translateY(-80.64%);
            }
            20% {
                transform: translateY(-69.75%);
            }
            24% {
                transform: translateY(-56.44%);
            }
            28% {
                transform: translateY(-40.71%);
            }
            32% {
                transform: translateY(-22.56%);
            }
            36% {
                transform: translateY(-1.99%);
            }

            40% {
                transform: translateY(-9%);
            }
            44% {
                transform: translateY(-19.36%);
            }
            48% {
                transform: translateY(-23.40%);
            }
            52% {
                transform: translateY(-21.14%);
            }
            56% {
                transform: translateY(-12.58%);
            }
            60% {
                transform: translateY(-2.75%);
            }

            64% {
                transform: translateY(-8.55%);
            }
            68% {
                transform: translateY(-10.89%);
            }
            72% {
                transform: translateY(-8.19%);
            }
            76% {
                transform: translateY(-1.70%);
            }

            80% {
                transform: translateY(-6%);
            }
            84% {
                transform: translateY(-5.89%);
            }
            88% {
                transform: translateY(-3.36%);
            }
            92% {
                transform: translateY(-0.66%);
            }
            96% {
                transform: translateY(-1.54%);
            }
            100% {
                transform: translateY(0);
            }
        }

        .square-leg {
            position: absolute;
            left: 0;
            top: 0;
        }

        .square-leg.vertical {
            height: 100%;
            width: 96px;
            margin-top: -1px;
            transform: translateX(-100%);

            background: repeating-linear-gradient(
                    to bottom,
                    var(--color-edge-square) 0 1px,
                    transparent 1px 6px
            ) left top / 6px 100% no-repeat,
            repeating-linear-gradient(
                    to bottom,
                    var(--color-edge-square) 0 1px,
                    transparent 1px 24px
            ) left top / 15px 100% no-repeat,
            repeating-linear-gradient(
                    to bottom,
                    var(--color-edge-square) 0 1px,
                    transparent 1px 48px
            ) left top / 30px 100% no-repeat,
            repeating-linear-gradient(
                    to bottom,
                    var(--color-edge-square) 0 1px,
                    transparent 1px 96px
            ) left top /60px 100% no-repeat;

            &.animate {
                animation: easeOutBounceY 1700ms linear both;
            }
        }

        .square-leg.horizontal {
            height: 96px;
            width: 100%;
            margin-left: -1px;
            transform: translateY(-100%);

            background: repeating-linear-gradient(
                    to right,
                    var(--color-edge-square) 0 1px,
                    transparent 1px 6px
            ) left top / 100% 6px no-repeat,
            repeating-linear-gradient(
                    to right,
                    var(--color-edge-square) 0 1px,
                    transparent 1px 24px
            ) left top / 100% 15px no-repeat,
            repeating-linear-gradient(
                    to right,
                    var(--color-edge-square) 0 1px,
                    transparent 1px 48px
            ) left top / 100% 30px no-repeat,
            repeating-linear-gradient(
                    to right,
                    var(--color-edge-square) 0 1px,
                    transparent 1px 96px
            ) left top / 100% 60px no-repeat;

            &.animate {
                animation: slide-in-down 1700ms cubic-bezier(0.34, 1.3, 0.8, 1) both;
            }
        }
    </style>
    <script>
        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('animate');
                }
            })
        }, {rootMargin: '0px 0px -50% 0px',});

        document.querySelectorAll('.carpenter-square .square-leg').forEach((entry) => observer.observe(entry))

    </script>
</div>